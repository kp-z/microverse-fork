# Godot 4+ 特定忽略文件
.godot/
.import/
*.import

# 导出文件临时和备份
export/*.tmp
export/*.pck-*

# Godot 特定忽略
export.cfg

# 导入的翻译文件（从 CSV 自动生成）
*.translation

# Mono 特定忽略
.mono/
data_*/
mono_crash.*.json

# 系统/编辑器特定忽略
.tmp/
.DS_Store
Thumbs.db
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.buildpath

# IDE 特定文件
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 日志和数据库
*.log
*.sql
*.sqlite

# 备份文件
*.backup
*~

# 临时和缓存文件
*.cache
*.pid
*.seed
*.pid.lock

# ===========================================
# Asset 资源文件策略 - 忽略未使用的大型资源
# ===========================================

# 忽略外部地图（不在游戏中使用）
asset/maps/exteriors/

# 忽略大部分未使用的室内地图
asset/maps/interiors/*
# 但保留办公室场景实际使用的地图
!asset/maps/interiors/3_Bathroom_32x32.png
!asset/maps/interiors/Room_Builder_32x32.png
!asset/maps/interiors/Modern_Office_32x32.png
!asset/maps/interiors/Room_Builder_Office_32x32.png
!asset/maps/interiors/8_Gym_32x32.png
!asset/maps/interiors/23_Television_and_Film_Studio_32x32.png

# 忽略大量未使用的装饰物品
asset/objects/
asset/decorations/
asset/items/

# 保留核心角色资源（这些是必需的）
# asset/characters/ 目录保持跟踪

# 忽略大部分 UI 资源包，只保留实际使用的
asset/ui/singles32x32/
asset/ui/theme/unused/
